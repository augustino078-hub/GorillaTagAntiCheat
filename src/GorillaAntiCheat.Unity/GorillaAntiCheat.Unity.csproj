<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unity / BepInEx integration layer.

    This project is intentionally EXCLUDED from the solution and CI because it
    references Unity, Photon (PUN2) and BepInEx assemblies that ship inside the
    game install, not on NuGet. To build it locally, point GameManagedDir at your
    Gorilla Tag managed-assemblies folder, e.g.:

      dotnet build src/GorillaAntiCheat.Unity/GorillaAntiCheat.Unity.csproj \
        -p:GameManagedDir="C:/.../Gorilla Tag/Gorilla Tag_Data/Managed"

    The engine-agnostic detection logic lives in GorillaAntiCheat.Core, which IS
    built and unit-tested in CI.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>GorillaAntiCheat.Unity</AssemblyName>
    <RootNamespace>GorillaAntiCheat.Unity</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- Resolve the game's managed assemblies from an overridable path. -->
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">$(GTPATH)</GameManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GorillaAntiCheat.Core\GorillaAntiCheat.Core.csproj" />
  </ItemGroup>

  <!-- Game / framework references resolved from the local install. -->
  <ItemGroup Condition="'$(GameManagedDir)' != ''">
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManagedDir)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(GameManagedDir)/PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>$(GameManagedDir)/PhotonRealtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(GameManagedDir)/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameManagedDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
